# CutSieve automatically loads .env on local startup (shell env vars take precedence).
# Copy this file to .env and fill in your local paths and API key.
CUTSIEVE_R1_MEDIA_DIR=./work/r1-media
CUTSIEVE_DEV_PROXY_TARGET=http://127.0.0.1:8173
CUTSIEVE_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5173,http://localhost:5173
# SQLite target for explicit Alembic commands.
# CUTSIEVE_DATABASE_URL=sqlite:///work/migrations.db

# CUTSIEVE_FFMPEG_DIR=C:/tools/ffmpeg/bin
# CUTSIEVE_CAPTION_FONT=C:/Windows/Fonts/simhei.ttf
# CUTSIEVE_MEDIA_PYTHON=C:/path/to/media/python.exe
# CUTSIEVE_WHISPER_DIR=C:/models/faster-whisper
# CUTSIEVE_PADDLE_OCR_DIR=C:/models/paddleocr

# Optional local embeddings and Qdrant.
# CUTSIEVE_SEARCH_ENCODER_URL=http://127.0.0.1:18176
# CUTSIEVE_SEARCH_QDRANT_URL=http://127.0.0.1:6333
# CUTSIEVE_SEARCH_QDRANT_API_KEY=replace-me

# Optional OpenAI-compatible deployment. Set budget and price values before enabling paid calls.
# CUTSIEVE_MODEL_BASE_URL=https://example.invalid/v1
# CUTSIEVE_MODEL_MODEL=deepseek-flash
# CUTSIEVE_MODEL_API_KEY=replace-me
# CUTSIEVE_MODEL_VERSION=<response model ID when it differs from the request model>
# CUTSIEVE_MODEL_VISION=0  # Set for text-only deployments.
# CUTSIEVE_MODEL_NATIVE_TOOLS=1  # Set if the deployment supports native tool calls.
CUTSIEVE_WORKFLOW_LIVE_MODEL=0
CUTSIEVE_MEDIA_REMOTE_FLASH=0
CUTSIEVE_MEDIA_AUTO_VISUAL=0
CUTSIEVE_LOCAL_FLASH_INFERENCE=0
# CUTSIEVE_CHAT_LIVE_MODEL=1
# CUTSIEVE_CHAT_MAX_COST_MICROUNITS=100000
# CUTSIEVE_WORKSPACE_CNY_MAX_COST_MICROUNITS=<workspace ceiling in millionths of a yuan>
# CUTSIEVE_MEDIA_VISUAL_MAX_CNY_MICROUNITS=<per-processing-run ceiling>
# CUTSIEVE_FLASH_PRICE_VERSION=<verified provider price revision>
# CUTSIEVE_FLASH_CNY_INPUT_MICROS_PER_MILLION=<input rate>
# CUTSIEVE_FLASH_CNY_OUTPUT_MICROS_PER_MILLION=<output rate>
