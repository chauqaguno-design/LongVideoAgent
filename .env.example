# ReelCue stores accounts, editing state, and media under this directory.
DOVIDEO_R1_MEDIA_DIR=./work/r1-media
# SQLite target for explicit Alembic commands.
# DOVIDEO_DATABASE_URL=sqlite:///work/migrations.db

# DOVIDEO_FFMPEG_DIR=C:/tools/ffmpeg/bin
# DOVIDEO_CAPTION_FONT=C:/Windows/Fonts/simhei.ttf
# DOVIDEO_MEDIA_PYTHON=C:/path/to/media/python.exe
# DOVIDEO_WHISPER_DIR=C:/models/faster-whisper
# DOVIDEO_PADDLE_OCR_DIR=C:/models/paddleocr

# Optional local embeddings and Qdrant.
# VIDEOMIND_SEARCH_ENCODER_URL=http://127.0.0.1:18176
# VIDEOMIND_SEARCH_QDRANT_URL=http://127.0.0.1:6333
# VIDEOMIND_SEARCH_QDRANT_API_KEY=replace-me

# Optional OpenAI-compatible deployment. Set budget and price values before enabling paid calls.
# DOVIDEO_MODEL_BASE_URL=https://example.invalid/v1
# DOVIDEO_MODEL_MODEL=deepseek-flash
# DOVIDEO_MODEL_API_KEY=replace-me
# DOVIDEO_MODEL_VERSION=<response model ID when it differs from the request model>
# DOVIDEO_MODEL_VISION=0  # Set for text-only deployments.
# DOVIDEO_MODEL_NATIVE_TOOLS=1  # Set if the deployment supports native tool calls.
DOVIDEO_WORKFLOW_LIVE_MODEL=0
DOVIDEO_MEDIA_REMOTE_FLASH=0
DOVIDEO_MEDIA_AUTO_VISUAL=0
DOVIDEO_LOCAL_FLASH_INFERENCE=0
# DOVIDEO_CHAT_LIVE_MODEL=1
# DOVIDEO_CHAT_MAX_COST_MICROUNITS=100000
# DOVIDEO_WORKSPACE_CNY_MAX_COST_MICROUNITS=<workspace ceiling in millionths of a yuan>
# DOVIDEO_MEDIA_VISUAL_MAX_CNY_MICROUNITS=<per-processing-run ceiling>
# DOVIDEO_FLASH_PRICE_VERSION=<verified provider price revision>
# DOVIDEO_FLASH_CNY_INPUT_MICROS_PER_MILLION=<input rate>
# DOVIDEO_FLASH_CNY_OUTPUT_MICROS_PER_MILLION=<output rate>
