# 本机服务，启动命令 python -m cinetrace
CINETRACE_PORT=8791

# 可填写 faster-whisper 支持的模型名或本地模型目录。
CINETRACE_WHISPER_MODEL=turbo

# 来自同一地域的百炼工作空间。填写两项后，视觉分析会向百炼发送短片。
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=

# 按需启用的本地组件，安装方法见 README。
CINETRACE_LOCAL_VISION=
CINETRACE_OCR=0
CINETRACE_QDRANT_URL=
CINETRACE_EMBED_MODEL=
CINETRACE_KAFKA=
