{
  "version": "1.0",
  "description": "目标应用工具合同；本文件不是向本轮助手注入工具。schema外部引用须以本文件目录为base解析，发给provider前bundle；内部工具名与provider_name双向映射且验证唯一。",
  "tools": [
    {
      "name": "video.search_evidence",
      "provider_name": "video__search_evidence",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/SearchRequest"
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/SearchResult"
      },
      "timeout_seconds": 15,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "沿用既有逻辑适配。ACL先于topK。图像输入仅artifact_id。返回候选，不自动代表核实。"
    },
    {
      "name": "video.get_segment",
      "provider_name": "video__get_segment",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          }
        },
        "required": [
          "media_revision_id",
          "range"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          }
        },
        "required": [
          "evidence_ids",
          "artifact_ids",
          "range"
        ]
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "验证媒体范围与权限；返回引用和受限摘要，非整段base64。"
    },
    {
      "name": "video.get_context_window",
      "provider_name": "video__get_context_window",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "before_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "after_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "evidence_id",
          "before_us",
          "after_us"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          }
        },
        "required": [
          "evidence_ids",
          "range"
        ]
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "返回合法裁剪后的上下文窗口。"
    },
    {
      "name": "video.inspect_overview",
      "provider_name": "video__inspect_overview",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "ARTIFACT_WRITE",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "media_revision_id",
          "range",
          "idempotency_key"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/JobRef"
      },
      "timeout_seconds": 5,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": true,
      "notes": "异步生成概览/manifest，kind=INSPECTION；不阻塞等待完整解码。由job结果读取artifact与实际PTS。"
    },
    {
      "name": "video.inspect_clip",
      "provider_name": "video__inspect_clip",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "ARTIFACT_WRITE",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          },
          "max_frames": {
            "type": "integer",
            "minimum": 2,
            "maximum": 48
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "media_revision_id",
          "range",
          "max_frames",
          "idempotency_key"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/JobRef"
      },
      "timeout_seconds": 5,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": true,
      "notes": "kind=INSPECTION。局部密集连续帧，source bounds、全局图数预算和artifact复用均由服务执行。"
    },
    {
      "name": "video.read_region",
      "provider_name": "video__read_region",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "ARTIFACT_WRITE",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame_artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "crop": {
            "$ref": "./schemas/domain.schema.json#/$defs/Crop"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "frame_artifact_id",
          "crop",
          "idempotency_key"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/JobRef"
      },
      "timeout_seconds": 5,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": true,
      "notes": "kind=INSPECTION。原始分辨率ROI；验证坐标，返回裁图及坐标映射，不能只放大小拼图。"
    },
    {
      "name": "video.check_coverage",
      "provider_name": "video__check_coverage",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          },
          "query_run_id": {
            "type": "string",
            "format": "uuid"
          },
          "protocol_id": {
            "type": "string"
          }
        },
        "required": [
          "media_revision_id",
          "range",
          "query_run_id",
          "protocol_id"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PARTIAL",
              "PROTOCOL_COMPLETE"
            ]
          },
          "unverified_ranges": {
            "type": "array",
            "items": {
              "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
            },
            "minItems": 0
          }
        },
        "required": [
          "status",
          "unverified_ranges"
        ]
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "协议覆盖不等于语义零漏检；全局查询必须调用并保留结果。"
    },
    {
      "name": "audio.inspect_transcript",
      "provider_name": "audio__inspect_transcript",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "range": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimeRange"
          }
        },
        "required": [
          "media_revision_id",
          "range"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "conflict_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          }
        },
        "required": [
          "observation_ids",
          "quality_flags",
          "conflict_evidence_ids"
        ]
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "读取ASR、VAD与字幕不同来源；异常复核另走处理作业，不能硬裁音乐=无语音。"
    },
    {
      "name": "edit.get_timeline",
      "provider_name": "edit__get_timeline",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edit_project_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "edit_project_id",
          "revision_id"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/TimelineRevision"
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "只读固定revision；默认最新需先由协调器解析并锁定revision_id。"
    },
    {
      "name": "edit.apply_patch",
      "provider_name": "edit__apply_patch",
      "allowed_roles": [
        "COORDINATOR"
      ],
      "effect": "TIMELINE_WRITE",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edit_project_id": {
            "type": "string",
            "format": "uuid"
          },
          "patch": {
            "$ref": "./schemas/domain.schema.json#/$defs/TimelinePatch"
          }
        },
        "required": [
          "edit_project_id",
          "patch"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/OperationReceipt"
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": true,
      "notes": "单写者。Editor仅提交建议patch artifact；代理不能跳过CAS/幂等或改变workspace。"
    },
    {
      "name": "edit.validate_timeline",
      "provider_name": "edit__validate_timeline",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "revision_id"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "valid",
          "errors",
          "warnings"
        ]
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "检查源范围、音轨、字幕、画幅、总时长、证据可追溯与brief约束；模型不能改写验证结果。"
    },
    {
      "name": "render.submit",
      "provider_name": "render__submit",
      "allowed_roles": [
        "COORDINATOR"
      ],
      "effect": "RENDER_WRITE",
      "input_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/RenderCreate"
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/RenderJob"
      },
      "timeout_seconds": 5,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": true,
      "notes": "固定revision；空时间线422 EMPTY_TIMELINE不入队；返回job并进入WAITING_JOB。"
    },
    {
      "name": "jobs.get",
      "provider_name": "jobs__get",
      "allowed_roles": [
        "COORDINATOR",
        "MATERIAL",
        "EDITOR",
        "REVIEWER"
      ],
      "effect": "READ",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "job_id"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/JobView"
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": false,
      "notes": "校验所属run/workspace；terminal由kind与状态计算。PARTIAL是本次处理的终态，重跑创建新attempt/run；由持久调度恢复，不靠模型无限轮询。"
    },
    {
      "name": "jobs.cancel",
      "provider_name": "jobs__cancel",
      "allowed_roles": [
        "COORDINATOR"
      ],
      "effect": "JOB_WRITE",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "job_id",
          "idempotency_key"
        ]
      },
      "output_schema": {
        "$ref": "./schemas/domain.schema.json#/$defs/JobView"
      },
      "timeout_seconds": 10,
      "server_injected": [
        "workspace_id",
        "actor_id",
        "run_id",
        "budget_reservation_id"
      ],
      "idempotency_required": true,
      "notes": "协作取消，持久保存cancel_requested_at；检查终态竞态并返回实际状态。"
    }
  ]
}
